  {
   "body": "Council",
   "motion": "to Establish that we set December 5, 2024, at 6:00 PM as the deadline for individuals to submit their names for consideration to fill the vacancy of the office of the mayor",
   "motion_type": "Other",
   "result": "5-0 Pass",
   "mover": "Heidi Robinson",
   "seconder": "Bonnie Billings",
   "aye": [
