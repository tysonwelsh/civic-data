  },
  {
   "body": "Council",
   "motion": "to Establish that the candidates be interviewed in the order they submit their applications",
   "motion_type": "Other",
   "result": "5-0 Pass",
   "mover": "Heidi Robinson",
   "seconder": "Bonnie Billings",
   "aye": [
    "Bonnie Billings",
    "Paul Glover",
